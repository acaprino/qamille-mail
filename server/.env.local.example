# Copia in server/.env (non si committa) e scrivi la chiave amministratore.
# Genera una chiave lunga e non ripetitiva, per esempio:
#   openssl rand -base64 48
#   (PowerShell) [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
# Il server rifiuta le chiavi brevi o ripetitive.
QAMILLE_ADMIN_KEY=

# Assistente interno (modello predefinito scaricato da Hugging Face), spento finché non lo accendi:
# QAMILLE_LLM_PROVIDER=builtin
# QAMILLE_LLM_BUILTIN_MODEL=llm-piccolo    llm-piccolo, llm-medio o llm-grande
# QAMILLE_LLM_BUILTIN_CONTEXT=8192
# QAMILLE_LLM_BUILTIN_IDLE_SECS=600
# QAMILLE_LLM_BUILTIN_SLOTS=1
# QAMILLE_MODELS_MIRROR_URL=
# Token di Hugging Face: solo per modelli con licenza da accettare (il catalogo predefinito non ne ha bisogno).
QAMILLE_HF_TOKEN=
