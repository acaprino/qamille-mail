# Copia questo file in .env (accanto a compose.yaml) e compilalo.
# .env contiene segreti: non metterlo nel repository e tienilo leggibile solo da te
# (chmod 600 .env).

# Dominio pubblico del server: Caddy chiede da sé il certificato TLS.
QAMILLE_DOMAIN=calcolo.example.com

# Chiave amministratore per la pagina /admin (almeno 32 caratteri, 8 diversi).
# Generala con:
#   openssl rand -hex 32
# Vuota: l'ascolto amministrativo non si apre.
QAMILLE_ADMIN_KEY=

# self-hosted (solo informativo, lo riporta GET /v1/info). Registrazione, posta, Google e
# abbonamenti sono dell'edizione enterprise: vedi il repository enterprise, privato.
QAMILLE_EDITION=self-hosted

# Assistente (gateway LLM): spento finché QAMILLE_LLM_PROVIDER è vuoto. Le app lo usano con la
# chiave del dispositivo; il server inoltra a un modello compatibile con OpenAI. Vedi README.md,
# «Assistente (gateway LLM)».
#
# Esempio con un modello interno (Ollama nello stesso compose, vedi compose.yaml):
# QAMILLE_LLM_PROVIDER=openai-compatible
# QAMILLE_LLM_BASE_URL=http://ollama:11434/v1
# QAMILLE_LLM_MODEL=qwen2.5:14b
#
# Esempio con OpenAI (un servizio esterno: le app ne chiedono il consenso per nome). Con un
# provider a pagamento imposta un tetto giornaliero di token per utente, per esempio 200000.
# QAMILLE_LLM_PROVIDER=openai-compatible
# QAMILLE_LLM_BASE_URL=https://api.openai.com/v1
# QAMILLE_LLM_MODEL=gpt-4.1-mini
# QAMILLE_LLM_MAX_TOKENS_PER_DAY_PER_USER=200000
#
# Altre regolazioni (valori predefiniti tra parentesi):
# QAMILLE_LLM_ALLOWED_MODELS=         altri modelli ammessi, separati da virgole (solo il predefinito)
# QAMILLE_LLM_MAX_OUTPUT_TOKENS=4096  tetto ai token di risposta
# QAMILLE_LLM_CONTEXT_TOKENS=         lunghezza del contesto del modello, dichiarata alle app
# QAMILLE_LLM_MAX_REQUEST_BYTES=2097152
# QAMILLE_LLM_TIMEOUT_SECS=120
# QAMILLE_LLM_MAX_IN_FLIGHT_PER_USER=2
# QAMILLE_LLM_MAX_IN_FLIGHT_TOTAL=16
# QAMILLE_LLM_LABEL=                  nome mostrato nel consenso (dall'host)
# QAMILLE_LLM_EXTERNAL=               1 o 0 per forzare «servizio esterno» (dedotto dall'host)
#
# Modello predefinito scaricato da Hugging Face e acceso dal server. Esempio:
# QAMILLE_LLM_PROVIDER=builtin
# QAMILLE_LLM_BUILTIN_MODEL=llm-piccolo
# Le altre regolazioni (QAMILLE_LLM_PROVIDER=builtin):
# QAMILLE_LLM_BUILTIN_MODEL=          llm-piccolo, llm-medio o llm-grande (obbligatorio con builtin)
# QAMILLE_LLM_BUILTIN_CONTEXT=8192    contesto di ogni richiesta, in token (da 1024 a 262144)
# QAMILLE_LLM_BUILTIN_IDLE_SECS=600   secondi senza richieste dopo i quali il modello si scarica (almeno 10)
# QAMILLE_LLM_BUILTIN_SLOTS=1         richieste servite insieme dal modello (da 1 a 4)
# QAMILLE_LLM_BUILTIN_PROGRAM=        solo Linux fuori dall'immagine: percorso assoluto di llama-server
# QAMILLE_LLM_ACCEPT_LICENSE=       gemma: accetti le condizioni dei modelli Gemma; senza, il server non li scarica da solo
# QAMILLE_MODELS_MIRROR_URL=          specchio di huggingface.co e github.com (https, o http verso la rete interna)
# Token di Hugging Face (solo per modelli con licenza da accettare; il catalogo predefinito non ne ha bisogno).
QAMILLE_HF_TOKEN=
#
# Chiave del provider (solo OpenAI o simili; vuota con un modello interno). Mai nel repository.
QAMILLE_LLM_API_KEY=

# Sincronizzazione delle caselle tra i computer dello stesso utente. Vuota: spenta.
# Genera la chiave con `qamille-server sync keygen` (docker compose run --rm server sync keygen) e tienila qui,
# fuori dal database e dai backup di server.db: senza di lei gli elementi salvati non si aprono. Mai nel repository.
QAMILLE_SYNC_KEY=
# Solo per `sync rekey` (la chiave precedente); poi toglila.
# QAMILLE_SYNC_KEY_OLD=
# QAMILLE_SYNC_MAX_ITEMS=200          caselle per utente (da 1 a 10000)
# QAMILLE_SYNC_MAX_ITEM_BYTES=65536   byte di una casella (da 1024 a 1048576)

# Porte di Caddy sull'host (cambiale solo per le prove).
# QAMILLE_HTTP_PORT=80
# QAMILLE_HTTPS_PORT=443

# Solo per chi aggiorna un server installato come Sparklone: riusa i volumi
# esistenti (utenti, modelli, certificati). Prima ferma il vecchio progetto con
#   docker compose -p sparklone down      (senza -v)
# Vedi README.md, «Aggiornamento da Sparklone».
# QAMILLE_DATA_VOLUME=sparklone_data
# QAMILLE_CADDY_DATA_VOLUME=sparklone_caddy_data
# QAMILLE_CADDY_CONFIG_VOLUME=sparklone_caddy_config
