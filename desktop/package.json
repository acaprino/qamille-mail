{
  "name": "qamille-desktop",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "artcraft:sync": "node scripts/sync-artcraft.mjs",
    "sigrid:sync": "node scripts/sync-sigrid.mjs",
    "ds:export": "node scripts/ds-export.mjs",
    "predev": "npm run artcraft:sync",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write src tests *.json *.ts *.js",
    "prebuild": "npm run artcraft:sync",
    "build": "npm run check && npm run test:ds && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "node tests/smoke.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:ds": "node tests/ds-usage.mjs && node tests/style-tokens.mjs && node tests/tokens-compatto.mjs && node tests/contrast.mjs light dark",
    "test:activity": "node --test tests/activity.mjs tests/activity-log.mjs tests/activity-page.mjs",
    "test:undo": "node --test tests/undo-notices.mjs && node tests/undo.mjs",
    "test:refresh": "node tests/refresh-coalesce.mjs",
    "test:events": "node --test tests/events.mjs",
    "test:indexing-polling": "node tests/indexing-polling.mjs",
    "test:done-latency": "node tests/done-latency.mjs",
    "test:mail-opening": "node tests/mail-opening.mjs",
    "test:composers": "node tests/composer-tabs.mjs",
    "test:attachments": "node tests/attachment-import-leases.mjs",
    "test:attachment-preview": "node tests/attachment-preview.mjs",
    "test:embedded-preview": "node tests/embedded-preview.mjs",
    "test:attachment-panel": "node tests/attachment-panel.mjs",
    "test:mail-drag": "node tests/mail-drag-attach.mjs",
    "test:meetings": "node tests/meetings.mjs",
    "test:meetings:native": "node tests/meetings-native.mjs",
    "test:startup:native": "node tests/workspace-startup-native.mjs",
    "test:release-theme": "node tests/release-theme-probe.mjs",
    "test:sidebar": "node tests/sidebar-threads.mjs",
    "test:sync": "node tests/mail-sync-feedback.mjs",
    "test:sync:native": "node tests/mail-sync-feedback-native.mjs",
    "test:calendar": "node tests/calendar-flow.mjs",
    "test:contacts": "node tests/contacts.mjs",
    "test:html": "node tests/mail-html.mjs",
    "test:ds-export": "node tests/ds-export.mjs",
    "test:assistant": "node --test tests/assistant-server.mjs",
    "test:native-feel": "node tests/native-feel.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@internationalized/date": "3.12.4",
    "@tauri-apps/api": "^2.10.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "clsx": "2.1.1",
    "dompurify": "^3.2.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
